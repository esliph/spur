#!/bin/sh
# spur - Simple Portable Universal Runner
# https://github.com/esliph/spur
#
# A task runner in strict POSIX sh. There is no runtime and no build step:
# this file is the whole program.

VERSION=0.1.0

# --------------------------------------------------------------- diagnostics

# die CODE MESSAGE...
die() {
  code=$1
  shift
  printf 'spur: %s\n' "$*" >&2
  exit "$code"
}

usage() {
  cat <<EOF
spur $VERSION - Simple Portable Universal Runner

Usage:
  spur [runner flags] <task> [task arguments...]

The first word that does not start with '-' is the task name. Everything
after it belongs to the task and is passed through untouched.

Runner flags:
  -f FILE        use FILE instead of searching for a Spurfile
  -C DIR         change to DIR before anything else
  -l, --list     list the tasks and exit
  -n             print the assembled script instead of running it
  --check        syntax-check the task (or every task) without running it
  --names        print the task names, one per line, and exit
  --describe     print the task's long help (its ## block) and exit
  -x             trace commands (set -x) after the preamble
  -h, --help     show this help and exit
  -v, --version  show the version and exit

Running spur with no task name lists the tasks.

Exit codes:
  64  usage error          65  malformed Spurfile
  66  Spurfile not found   67  unknown task
  68  recursion detected
A task's own exit code is propagated unchanged.
EOF
}

# ------------------------------------------------------------------ locating

# Absolute path of this script. Must run before any directory change.
resolve_self() {
  case $0 in
    */*)
      printf '%s/%s\n' "$(cd "$(dirname "$0")" && pwd)" "$(basename "$0")"
      ;;
    *)
      self=$(command -v -- "$0" 2>/dev/null) || self=$0
      case $self in
        /*) printf '%s\n' "$self" ;;
        *) printf '%s/%s\n' "$(cd "$(dirname "$self")" && pwd)" "$(basename "$self")" ;;
      esac
      ;;
  esac
}

# Print the nearest Spurfile, searching upwards from the current directory.
find_spurfile() {
  dir=$PWD
  while :; do
    if [ -f "$dir/Spurfile" ]; then
      printf '%s/Spurfile\n' "$dir"
      return 0
    fi
    if [ -f "$dir/spurfile" ]; then
      printf '%s/spurfile\n' "$dir"
      return 0
    fi
    parent=$(dirname "$dir")
    [ "$parent" = "$dir" ] && return 1
    dir=$parent
  done
}

# ------------------------------------------------------------------- parsing

# The Spurfile parser. Modes:
#   list      one formatted line per task, under its ##@ section heading
#   preamble  every line before the first task header
#   names     one task name per line, in file order
#   body      the dedented body of the task named by "want"
#   describe  the header description of "want", then the ## block right
#             above its header, without the leading "##" and one space
# Diagnostics go to stdout; the exit status carries the meaning (65 syntax,
# 67 unknown task), because /dev/stderr is not portable across awks.
# shellcheck disable=SC2016  # awk source, deliberately not expanded by sh
AWK_PARSER='
function err(msg) { printf "%s:%d: %s\n", file, NR, msg; failed = 1; exit 65 }
function ws(s) { match(s, /^[ \t]*/); return substr(s, 1, RLENGTH) }
function cprefix(a, b,   i, n) {
  n = length(a); if (length(b) < n) n = length(b)
  for (i = 1; i <= n; i++) if (substr(a, i, 1) != substr(b, i, 1)) return substr(a, 1, i - 1)
  return substr(a, 1, n)
}
# Edit distance counting a swap of two adjacent characters as one edit.
function dist(a, b,   la, lb, i, j, c, v, d) {
  la = length(a); lb = length(b)
  for (i = 0; i <= la; i++) d[i, 0] = i
  for (j = 0; j <= lb; j++) d[0, j] = j
  for (i = 1; i <= la; i++) for (j = 1; j <= lb; j++) {
    c = (substr(a, i, 1) != substr(b, j, 1))
    v = d[i - 1, j - 1] + c
    if (d[i - 1, j] + 1 < v) v = d[i - 1, j] + 1
    if (d[i, j - 1] + 1 < v) v = d[i, j - 1] + 1
    if (i > 1 && j > 1 && substr(a, i, 1) == substr(b, j - 1, 1) &&
        substr(a, i - 1, 1) == substr(b, j, 1) && d[i - 2, j - 2] + 1 < v)
      v = d[i - 2, j - 2] + 1
    d[i, j] = v
  }
  return d[la, lb]
}
# Report an unknown "want", with up to three close task names: within a
# third of its length in edits, or starting with it. Closest first, then
# file order.
function unknown(   w, lim, i, j, k, n, best, out, cand, cd, used) {
  printf "unknown task: %s\n", want
  w = tolower(want); lim = int(length(w) / 3); if (lim < 1) lim = 1
  n = 0
  for (i = 1; i <= nt; i++) {
    k = dist(w, tolower(tname[i]))
    if (k <= lim || (length(w) >= 2 && index(tolower(tname[i]), w) == 1)) {
      cand[++n] = i; cd[i] = k
    }
  }
  out = ""
  for (k = 1; k <= 3; k++) {
    best = 0
    for (j = 1; j <= n; j++)
      if (!(cand[j] in used) && (best == 0 || cd[cand[j]] < cd[best])) best = cand[j]
    if (best == 0) break
    used[best] = 1
    out = out (out == "" ? "" : ", ") tname[best]
  }
  if (out != "") printf "did you mean: %s?\n", out
  exit 67
}
BEGIN { started = 0; in_body = 0; capturing = 0; found = 0; nb = 0; npre = 0; nt = 0; nd = 0; dend = -1; maxlen = 0; cursec = "Tasks" }
{
  line = $0
  sub(/\r$/, "", line)
  if (line ~ /^[ \t]*$/) {
    if (in_body) { if (capturing) body[++nb] = line }
    else if (!started) pre[++npre] = line
    next
  }
  if (line ~ /^[ \t]/) {
    if (in_body) { if (capturing) body[++nb] = line; next }
    if (!started) { pre[++npre] = line; next }
    err("indented line does not belong to any task")
  }
  if (line ~ /^##@/) {
    cursec = substr(line, 4); sub(/^[ \t]+/, "", cursec); sub(/[ \t]+$/, "", cursec)
    if (cursec == "") cursec = "Tasks"
  }
  if (line ~ /^##/ && line !~ /^##@/) {
    if (dend != NR - 1) nd = 0
    t = substr(line, 3); sub(/^ /, "", t)
    doc[++nd] = t; dend = NR
  }
  if (line ~ /^#/) { in_body = 0; capturing = 0; if (!started) pre[++npre] = line; next }
  if (line ~ /^[A-Za-z0-9_.-]+:/) {
    colon = index(line, ":")
    name = substr(line, 1, colon - 1)
    rest = substr(line, colon + 1)
    h = index(rest, "##")
    if (h > 0) { lead = substr(rest, 1, h - 1); desc = substr(rest, h + 2) }
    else { lead = rest; desc = "" }
    if (lead ~ /[^ \t]/) err("task header takes no prerequisites: " name)
    sub(/^[ \t]+/, "", desc); sub(/[ \t]+$/, "", desc)
    if (name in seen) err("duplicate task: " name)
    seen[name] = 1
    tname[++nt] = name; tdesc[nt] = desc; tsec[nt] = cursec
    if (length(name) > maxlen) maxlen = length(name)
    started = 1; in_body = 1
    capturing = (mode == "body" && name == want)
    if (capturing) found = 1
    if (mode == "describe" && name == want) {
      found = 1; wdesc = desc; wnd = 0
      if (dend == NR - 1) for (i = 1; i <= nd; i++) wdoc[++wnd] = doc[i]
    }
    next
  }
  if (!started) { pre[++npre] = line; next }
  err("syntax error: expected a task header")
}
END {
  if (failed) exit 65
  if (mode == "list") {
    fmt = "  %-" (maxlen + 3) "s%s\n"
    for (i = 1; i <= nt; i++) {
      if (i > 1 && tsec[i] != tsec[i - 1]) printf "\n"
      if (i == 1 || tsec[i] != tsec[i - 1]) print tsec[i]
      if (tdesc[i] == "") printf "  %s\n", tname[i]
      else printf fmt, tname[i], tdesc[i]
    }
    exit 0
  }
  if (mode == "names") {
    for (i = 1; i <= nt; i++) print tname[i]
    exit 0
  }
  if (mode == "describe") {
    if (!found) unknown()
    first = 1
    while (first <= wnd && wdoc[first] ~ /^[ \t]*$/) first++
    if (wdesc != "") print want ": " wdesc
    else if (first > wnd) print want ": (no description)"
    else print want
    if (first <= wnd) print ""
    for (i = first; i <= wnd; i++) print wdoc[i]
    exit 0
  }
  if (mode == "preamble") {
    for (i = 1; i <= npre; i++) print pre[i]
    exit 0
  }
  if (mode == "body") {
    if (!found) unknown()
    while (nb > 0 && body[nb] ~ /^[ \t]*$/) nb--
    pfx = ""; first = 1
    for (i = 1; i <= nb; i++) {
      if (body[i] ~ /^[ \t]*$/) continue
      if (first) { pfx = ws(body[i]); first = 0 }
      else pfx = cprefix(pfx, ws(body[i]))
    }
    n = length(pfx)
    for (i = 1; i <= nb; i++) {
      if (body[i] ~ /^[ \t]*$/) print ""
      else print substr(body[i], n + 1)
    }
    exit 0
  }
}
'

PARSER_OUT=

# run_parser MODE WANT -- leaves the parser output in PARSER_OUT and returns
# the parser exit status. Must stay a function, never a command substitution,
# so that the caller can exit on failure.
run_parser() {
  PARSER_OUT=$(
    awk -v mode="$1" -v want="$2" -v file="$(basename "$SPUR_FILE")" \
      "$AWK_PARSER" "$SPUR_FILE"
  )
}

# parser_error STATUS -- report PARSER_OUT and exit.
parser_error() {
  printf '%s\n' "$PARSER_OUT" | while IFS= read -r line; do
    printf 'spur: %s\n' "$line"
  done >&2
  if [ "$1" -eq 67 ]; then
    printf "spur: run 'spur --list' to see the available tasks\n" >&2
  fi
  exit "$1"
}

list_tasks() {
  run_parser list "" || parser_error $?
  printf 'Spurfile: %s\n\n' "$SPUR_FILE"
  if [ -n "$PARSER_OUT" ]; then
    printf '%s\n' "$PARSER_OUT"
  else
    printf '  (no tasks defined)\n'
  fi
}

# ----------------------------------------------------------- argument parsing

spurfile_opt=
chdir_opt=
list_opt=
dry_opt=
trace_opt=
check_opt=
names_opt=
describe_opt=

while [ $# -gt 0 ]; do
  case $1 in
    -f)
      [ $# -ge 2 ] || die 64 "option -f requires an argument"
      spurfile_opt=$2
      shift 2
      ;;
    -C)
      [ $# -ge 2 ] || die 64 "option -C requires an argument"
      chdir_opt=$2
      shift 2
      ;;
    -l | --list)
      list_opt=1
      shift
      ;;
    -n)
      dry_opt=1
      shift
      ;;
    -x)
      trace_opt=1
      shift
      ;;
    --check)
      check_opt=1
      shift
      ;;
    --names)
      names_opt=1
      shift
      ;;
    --describe)
      describe_opt=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -v | --version)
      printf 'spur %s\n' "$VERSION"
      exit 0
      ;;
    -*)
      die 64 "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

if [ -n "$describe_opt" ] &&
  [ -n "$list_opt$dry_opt$trace_opt$check_opt$names_opt" ]; then
  die 64 "--describe cannot be combined with -l, -n, -x, --check or --names"
fi

if [ -n "$names_opt" ] && [ -n "$list_opt$dry_opt$trace_opt$check_opt" ]; then
  die 64 "--names cannot be combined with -l, -n, -x or --check"
fi

if [ -n "$check_opt" ] && [ -n "$list_opt$dry_opt$trace_opt" ]; then
  die 64 "--check cannot be combined with -l, -n or -x"
fi

if [ $# -gt 0 ]; then
  task=$1
  shift
else
  task=
fi

# ---------------------------------------------------------------------- setup

SPUR_BIN=$(resolve_self)
SPUR_INVOCATION_DIR=$PWD

if [ -n "$chdir_opt" ]; then
  cd "$chdir_opt" || die 64 "cannot change directory: $chdir_opt"
fi

if [ -n "$spurfile_opt" ]; then
  [ -f "$spurfile_opt" ] || die 66 "$spurfile_opt: no such file"
  SPUR_FILE=$(cd "$(dirname "$spurfile_opt")" && pwd)/$(basename "$spurfile_opt")
else
  SPUR_FILE=$(find_spurfile) ||
    die 66 "no Spurfile found in $PWD or any parent directory"
fi

SPUR_ROOT=$(dirname "$SPUR_FILE")
cd "$SPUR_ROOT" || die 66 "cannot enter $SPUR_ROOT"

# ------------------------------------------------------------------ assembly

# shellcheck disable=SC2016  # the prelude is literal text for the task shell
PRELUDE='set -e
spur() { "$SPUR_BIN" "$@"; }'

script=

# build_script TASK -- leaves the assembled script in the global "script".
build_script() {
  run_parser body "$1" || parser_error $?
  body=$PARSER_OUT
  run_parser preamble "" || parser_error $?
  preamble=$PARSER_OUT

  script=$(printf '%s\n%s\n' "$PRELUDE" "$preamble")
  if [ -n "$trace_opt" ]; then
    script=$(printf "%s\nPS4='\$ '\nset -x\n" "$script")
  fi
  script=$(printf '%s\n%s\n' "$script" "$body")
}

# ------------------------------------------------------------------ checking

check_failed=

# check_task TASK -- syntax-check the assembled script with sh -n, which
# parses without running anything. Errors are labelled like a real run.
check_task() {
  build_script "$1"
  if ! sh -n -c "$script" "spur $1"; then
    printf "spur: run 'spur -n %s' to see the assembled script\n" "$1" >&2
    check_failed=1
  fi
}

# check_tasks [TASK] -- check the preamble on its own first, so that a broken
# preamble is reported once instead of once per task; then TASK, or every
# task in file order. Exits 65 if anything fails to parse.
check_tasks() {
  run_parser preamble "" || parser_error $?
  sh -n -c "$(printf '%s\n%s\n' "$PRELUDE" "$PARSER_OUT")" "spur (preamble)" ||
    exit 65
  if [ -n "$1" ]; then
    check_task "$1"
  else
    run_parser names "" || parser_error $?
    # Task names match [A-Za-z0-9_.-]+, so splitting them cannot glob.
    # shellcheck disable=SC2086
    for name in $PARSER_OUT; do
      check_task "$name"
    done
  fi
  [ -z "$check_failed" ] || exit 65
}

if [ -n "$check_opt" ]; then
  check_tasks "$task"
  exit 0
fi

# ----------------------------------------------------------------- listing

# --names is the machine-readable list: bare names, and nothing at all when
# there are no tasks, so that completions and loops need no parsing.
if [ -n "$names_opt" ]; then
  run_parser names "" || parser_error $?
  [ -z "$PARSER_OUT" ] || printf '%s\n' "$PARSER_OUT"
  exit 0
fi

# --describe is the long help of one task: its header description, then the
# ## block right above its header. It runs nothing.
if [ -n "$describe_opt" ]; then
  [ -n "$task" ] || die 64 "no task given"
  run_parser describe "$task" || parser_error $?
  printf '%s\n' "$PARSER_OUT"
  exit 0
fi

if [ -n "$list_opt" ] || [ -z "$task" ]; then
  if [ -z "$task" ] && { [ -n "$dry_opt" ] || [ -n "$trace_opt" ]; }; then
    die 64 "no task given"
  fi
  list_tasks
  exit 0
fi

# ---------------------------------------------------------------- execution

SPUR_TASK=$task

case " ${SPUR_STACK:-} " in
  *" $task "*)
    chain=
    # shellcheck disable=SC2086
    for frame in ${SPUR_STACK:-}; do
      chain=${chain:+$chain -> }$frame
    done
    die 68 "recursion detected: ${chain:+$chain -> }$task"
    ;;
esac

build_script "$task"

if [ -n "$dry_opt" ]; then
  printf '%s\n' "$script"
  exit 0
fi

SPUR_STACK=${SPUR_STACK:+$SPUR_STACK }$task
export SPUR_BIN SPUR_ROOT SPUR_INVOCATION_DIR SPUR_TASK SPUR_STACK

exec sh -c "$script" "spur $task" "$@"
